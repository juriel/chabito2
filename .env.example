# Base
PI_PROVIDER=openai
PI_MODEL=gpt-5-mini
AGENT_SYSTEM_PROMPT=Eres Chabito. Responde de forma util, breve y amable por WhatsApp.

# API keys (set the one for your provider)
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional: override base URL for OpenAI-compatible APIs (OpenRouter, proxies, gateways)
# You can use either PI_BASE_URL or OPENAI_BASE_URL.
PI_BASE_URL=
OPENAI_BASE_URL=

# If you use a custom OpenRouter model id (e.g. `nvidia/...:free`) set:
#   PI_PROVIDER=openrouter
#   PI_MODEL=<that model id>
#   OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   OPENROUTER_API_KEY=...

# Optional OpenRouter headers (recommended by OpenRouter)
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_APP_NAME=chabito
